{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "jsPlugins": [
    { "name": "eslint-js", "specifier": "oxlint-plugin-eslint" },
    { "name": "livething", "specifier": "./lint-rules/index.mjs" }
  ],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    ".codex/**",
    "website/**",
    "vite.config.*.timestamp-*.*",
    "lint-staged.config.js"
  ],
  "rules": {
    "curly": ["error", "multi-line", "consistent"],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "func-style": ["error", "declaration"],
    "no-inner-declarations": ["error", "functions", { "blockScopedFunctions": "disallow" }],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "@typescript-eslint/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "@typescript-eslint/no-duplicate-enum-values": "error",
    "@typescript-eslint/no-extra-non-null-assertion": "error",
    "@typescript-eslint/no-misused-new": "error",
    "@typescript-eslint/no-namespace": "error",
    "@typescript-eslint/no-non-null-asserted-optional-chain": "error",
    "@typescript-eslint/no-unsafe-function-type": "error",
    "@typescript-eslint/no-wrapper-object-types": "error",
    "@typescript-eslint/prefer-as-const": "error",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/triple-slash-reference": "error",
    "@typescript-eslint/ban-ts-comment": [
      "error",
      { "ts-expect-error": false, "ts-ignore": "allow-with-description" }
    ],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/first": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-shadow": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-debugger": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-dupe-else-if": "error",
    "no-duplicate-case": "error",
    "no-empty-pattern": "error",
    "no-fallthrough": "error",
    "no-self-assign": "error",
    "no-sparse-arrays": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-control-regex": "error",
    "no-delete-var": "error",
    "no-empty-character-class": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-global-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-regex-spaces": "error",
    "no-shadow-restricted-names": "error",
    "no-with": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-useless-backreference": "error",
    "require-yield": "error",
    "no-nested-ternary": "error",
    "complexity": ["error", { "max": 50, "variant": "classic" }],
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "VariableDeclarator > Identifier > TSTypeAnnotation > TSTypeLiteral, :matches(FunctionDeclaration, FunctionExpression, ArrowFunctionExpression) Identifier > TSTypeAnnotation > TSTypeLiteral",
        "message": "Extract inline object types into a named type or interface."
      },
      {
        "selector": ":matches(FunctionDeclaration, FunctionExpression, ArrowFunctionExpression) > :matches(ObjectPattern, ArrayPattern), :matches(FunctionDeclaration, FunctionExpression, ArrowFunctionExpression) > AssignmentPattern > :matches(ObjectPattern, ArrayPattern)",
        "message": "Do not destructure function parameters; use a named parameter."
      }
    ],
    "livething/max-consecutive-statements": ["error", { "max": 5 }],
    "livething/max-params": ["error", { "max": 3 }],
    "livething/padding-after-block": "error",
    "livething/padding-after-guard-clause": "error",
    "livething/padding-after-object-literal-declaration": "error",
    "livething/padding-before-final-return": ["error", { "minStatements": 5 }],
    "livething/switch-case-padding": ["error", { "minCases": 3 }]
  },
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "rules": {
        "livething/max-consecutive-statements": "off",
        "livething/padding-after-block": "off",
        "livething/padding-after-guard-clause": "off",
        "livething/padding-after-object-literal-declaration": "off",
        "livething/padding-before-final-return": "off",
        "livething/switch-case-padding": "off"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test-d.ts",
        "**/*.bench.ts",
        "**/_test/**",
        "**/test-utils.ts",
        "tests-e2e/**"
      ],
      "rules": {
        "eslint-js/no-restricted-syntax": "off",
        "no-shadow": "warn"
      }
    },
    {
      "files": [".dependency-cruiser.cjs"],
      "rules": {
        "import/no-commonjs": "off"
      }
    },
    {
      "files": ["server/src/**/*.ts"],
      "excludeFiles": [
        "server/src/**/_test/**",
        "server/src/**/*.spec.ts",
        "server/src/**/*.test.ts",
        "server/src/**/*.test-d.ts",
        "server/src/**/*.bench.ts"
      ],
      "env": {
        "builtin": true
      },
      "globals": {
        "AbortController": "readonly",
        "AbortSignal": "readonly",
        "atob": "readonly",
        "Blob": "readonly",
        "btoa": "readonly",
        "clearInterval": "readonly",
        "clearTimeout": "readonly",
        "console": "readonly",
        "crypto": "readonly",
        "Event": "readonly",
        "EventTarget": "readonly",
        "fetch": "readonly",
        "FormData": "readonly",
        "Headers": "readonly",
        "MessageChannel": "readonly",
        "MessageEvent": "readonly",
        "MessagePort": "readonly",
        "performance": "readonly",
        "queueMicrotask": "readonly",
        "ReadableStream": "readonly",
        "Request": "readonly",
        "Response": "readonly",
        "setInterval": "readonly",
        "setTimeout": "readonly",
        "structuredClone": "readonly",
        "TextDecoder": "readonly",
        "TextEncoder": "readonly",
        "TransformStream": "readonly",
        "URL": "readonly",
        "URLSearchParams": "readonly",
        "WebSocket": "readonly",
        "WritableStream": "readonly"
      },
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-undef": ["error", { "typeof": true }],
        "no-restricted-properties": [
          "error",
          {
            "object": "globalThis",
            "message": "LiveThing server code must not read runtime globals through globalThis."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "cloudflare:workers",
                "message": "Runtime bindings belong in a server adapter."
              },
              {
                "name": "@livething/server-node",
                "message": "Server code must depend on adapter interfaces, not a runtime adapter."
              },
              {
                "name": "@livething/server-cloudflare",
                "message": "Server code must depend on adapter interfaces, not a runtime adapter."
              }
            ],
            "patterns": [
              {
                "group": ["@livething/server-node/*", "@livething/server-cloudflare/*"],
                "message": "Server code must depend on adapter interfaces, not a runtime adapter."
              }
            ]
          }
        ]
      }
    }
  ]
}
