{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "~/*": ["../server-codegen/src/*"],
      "@wskit/core": ["../../core/src/index.ts"],
      "@wskit/server-codegen": ["../server-codegen/src/index.ts"],
      "@wskit/server-codegen/*": ["../server-codegen/src/*"],
      "@wskit/server-codegen/registry": ["../server-codegen/src/registry.ts"],
      "@wskit/server-codegen/internal/define-server": ["../server-codegen/src/define-server.ts"],
      "@wskit/server-codegen/internal/define-module": ["../server-codegen/src/define-module.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
