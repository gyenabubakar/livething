{
  "name": "@wskit/server",
  "version": "1.0.0-beta.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "wskit-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "wskit-dev": "./src/_adapters/index.ts",
      "types": "./dist/_adapters/index.d.ts",
      "import": "./dist/_adapters/index.js"
    },
    "./modules": {
      "wskit-dev": "./src/modules/index.ts",
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules.js"
    },
    "./ack": {
      "wskit-dev": "./src/ack/index.ts",
      "types": "./dist/ack/index.d.ts",
      "import": "./dist/ack.js"
    },
    "./heartbeat": {
      "wskit-dev": "./src/heartbeat/index.ts",
      "types": "./dist/heartbeat/index.d.ts",
      "import": "./dist/heartbeat.js"
    },
    "./sequence": {
      "wskit-dev": "./src/sequence/index.ts",
      "types": "./dist/sequence/index.d.ts",
      "import": "./dist/sequence.js"
    },
    "./dedup": {
      "wskit-dev": "./src/dedup/index.ts",
      "types": "./dist/dedup/index.d.ts",
      "import": "./dist/dedup.js"
    },
    "./hibernation": {
      "wskit-dev": "./src/hibernation/index.ts",
      "types": "./dist/hibernation/index.d.ts",
      "import": "./dist/hibernation.js"
    },
    "./errors": {
      "wskit-dev": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors.js"
    },
    "./scheduled": {
      "wskit-dev": "./src/scheduled/index.ts",
      "types": "./dist/scheduled/index.d.ts",
      "import": "./dist/scheduled.js"
    },
    "./requests": {
      "wskit-dev": "./src/request/index.ts",
      "types": "./dist/request/index.d.ts",
      "import": "./dist/request.js"
    },
    "./intercept": {
      "wskit-dev": "./src/intercept/index.ts",
      "types": "./dist/intercept/index.d.ts",
      "import": "./dist/intercept.js"
    },
    "./channels": {
      "wskit-dev": "./src/channel/index.ts",
      "types": "./dist/channel/index.d.ts",
      "import": "./dist/channel.js"
    },
    "./namespaces": {
      "wskit-dev": "./src/namespace/index.ts",
      "types": "./dist/namespace/index.d.ts",
      "import": "./dist/namespace.js"
    },
    "./streams": {
      "wskit-dev": "./src/stream/index.ts",
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream.js"
    },
    "./replay": {
      "wskit-dev": "./src/replay/index.ts",
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay.js"
    },
    "./replay/custom": {
      "wskit-dev": "./src/replay/custom/index.ts",
      "types": "./dist/replay/custom/index.d.ts",
      "import": "./dist/replay/custom.js"
    },
    "./lifecycle": {
      "wskit-dev": "./src/lifecycle/index.ts",
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./infrastructure": {
      "wskit-dev": "./src/infrastructure/index.ts",
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure.js"
    },
    "./full": {
      "wskit-dev": "./src/full/index.ts",
      "types": "./dist/full/index.d.ts",
      "import": "./dist/full.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@wskit/core": "workspace:*"
  },
  "devDependencies": {
    "valibot": "^1.3.1",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6"
  }
}
