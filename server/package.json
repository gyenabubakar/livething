{
  "name": "@livething/server",
  "version": "1.0.0-alpha.0",
  "description": "Typed realtime WebSocket server framework for TypeScript: define events, requests and rooms once, and the client is typed from them. Runs on Node.js and Cloudflare.",
  "license": "MIT",
  "homepage": "https://livething.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyenabubakar/livething.git",
    "directory": "server"
  },
  "keywords": [
    "livething",
    "realtime",
    "websocket",
    "websocket-server",
    "typescript",
    "typed",
    "rooms",
    "pubsub",
    "presence",
    "server-sent-events",
    "real-time",
    "websockets",
    "type-safe",
    "trpc",
    "socket.io",
    "sse",
    "chat",
    "streaming",
    "multiplayer",
    "cloudflare-workers"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/_adapters/index.d.ts",
      "import": "./dist/_adapters/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors.js"
    },
    "./client-requests": {
      "types": "./dist/request/client-requests.d.ts",
      "import": "./dist/client-requests.js"
    },
    "./server-requests": {
      "types": "./dist/request/server-requests.d.ts",
      "import": "./dist/server-requests.js"
    },
    "./scheduled": {
      "types": "./dist/scheduled/capability.d.ts",
      "import": "./dist/scheduled.js"
    },
    "./dedup": {
      "types": "./dist/dedup/capability.d.ts",
      "import": "./dist/dedup.js"
    },
    "./sequence": {
      "types": "./dist/sequence/capability.d.ts",
      "import": "./dist/sequence.js"
    },
    "./keepalive": {
      "types": "./dist/keepalive/capability.d.ts",
      "import": "./dist/keepalive.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/capability.d.ts",
      "import": "./dist/rate-limit.js"
    },
    "./replay": {
      "types": "./dist/replay/capability.d.ts",
      "import": "./dist/replay.js"
    },
    "./inbox": {
      "types": "./dist/inbox/capability.d.ts",
      "import": "./dist/inbox.js"
    },
    "./awareness": {
      "types": "./dist/awareness/capability.d.ts",
      "import": "./dist/awareness.js"
    },
    "./last-seen": {
      "types": "./dist/last-seen/capability.d.ts",
      "import": "./dist/last-seen.js"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js"
    },
    "./channels": {
      "types": "./dist/channel/index.d.ts",
      "import": "./dist/channels.js"
    },
    "./binary": {
      "types": "./dist/binary/capability.d.ts",
      "import": "./dist/binary.js"
    },
    "./uploads": {
      "types": "./dist/upload/capability.d.ts",
      "import": "./dist/uploads.js"
    },
    "./tags": {
      "types": "./dist/tags/capability.d.ts",
      "import": "./dist/tags.js"
    },
    "./plugins": {
      "types": "./dist/_define/plugins.d.ts",
      "import": "./dist/plugins.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "valibot": "^1.3.1"
  },
  "peerDependencies": {
    "@livething/core": "^1.0.0-alpha.0"
  },
  "devDependencies": {
    "@livething/core": "workspace:*",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6"
  }
}
