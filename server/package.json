{
  "name": "@wskit/server",
  "version": "1.0.0-beta.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "wskit-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "wskit-dev": "./src/_adapters/index.ts",
      "types": "./dist/_adapters/index.d.ts",
      "import": "./dist/_adapters/index.js"
    },
    "./errors": {
      "wskit-dev": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@wskit/core": "workspace:*",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6"
  }
}
