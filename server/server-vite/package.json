{
  "name": "@wskit/server-vite",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "tinyglobby": "^0.2.15",
    "typescript": "^5.8.2",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "vite-plugin-dts": "^4.5.4"
  }
}
