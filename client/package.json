{
  "name": "@livething/client",
  "version": "1.0.0-alpha.0",
  "description": "Typed realtime WebSocket client for TypeScript, with types inferred from your LiveThing server: reconnection, requests, rooms, streams, replay and an HTTP fallback.",
  "license": "MIT",
  "homepage": "https://livething.dev/core/client/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyenabubakar/livething.git",
    "directory": "client"
  },
  "keywords": [
    "livething",
    "realtime",
    "websocket",
    "websocket-client",
    "typescript",
    "typed",
    "reconnect",
    "rooms",
    "server-sent-events",
    "react-native"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "@livething/core": "^1.0.0-alpha.0"
  },
  "devDependencies": {
    "@livething/core": "workspace:*",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
