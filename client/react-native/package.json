{
  "name": "@better-websocket/client-react-native",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@better-websocket/client": ">=0.0.1",
    "react": ">=18",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-websocket/client": "workspace:*",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
