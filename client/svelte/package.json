{
  "name": "@better-websocket/client-svelte",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "svelte-check && vite build",
    "typecheck": "svelte-check",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@better-websocket/client": ">=0.0.1",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@better-websocket/client": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.53.12",
    "svelte-check": "^4.4.5",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
