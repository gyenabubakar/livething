{
  "name": "@better-websocket/client-react",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@better-websocket/client": ">=0.0.1",
    "react": ">=18"
  },
  "devDependencies": {
    "@better-websocket/client": "workspace:*",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.4",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
