{
  "name": "@livething/server-cloudflare",
  "version": "1.0.0-alpha.0",
  "description": "Run a typed LiveThing realtime WebSocket server on Cloudflare Durable Objects and Workers, with WebSocket hibernation.",
  "license": "MIT",
  "homepage": "https://livething.dev/core/runtimes/adapters/cloudflare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyenabubakar/livething.git",
    "directory": "server-adapters/cloudflare"
  },
  "keywords": [
    "livething",
    "realtime",
    "websocket",
    "typescript",
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "hibernation",
    "real-time",
    "websockets",
    "partykit",
    "serverless"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "@livething/server": "^1.0.0-alpha.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@livething/server": "workspace:*",
    "vite": "8.0.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
