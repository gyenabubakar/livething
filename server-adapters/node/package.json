{
  "name": "@livething/server-node",
  "version": "1.0.0-beta.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./binding": {
      "types": "./dist/src/binding.d.ts",
      "import": "./dist/binding.js"
    },
    "./hono": {
      "types": "./dist/src/frameworks/hono/index.d.ts",
      "import": "./dist/hono.js"
    },
    "./fastify": {
      "types": "./dist/src/frameworks/fastify/index.d.ts",
      "import": "./dist/fastify.js"
    },
    "./h3": {
      "types": "./dist/src/frameworks/h3/index.d.ts",
      "import": "./dist/h3.js"
    },
    "./h3/v1": {
      "types": "./dist/src/frameworks/h3/v1/index.d.ts",
      "import": "./dist/h3-v1.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run --passWithNoTests && pnpm run test:h3-packages",
    "test:watch": "vitest --passWithNoTests",
    "test:h3-packages": "node check-h3-packages.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run --project websocket",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "@fastify/websocket": "^11.3.0",
    "@hono/node-server": "^2.1.1",
    "@livething/server": "^1.0.0-beta.0",
    "crossws": "^0.3.5 || ^0.4.12",
    "fastify": "^5.12.3",
    "h3": "^1.15.11 || ^2.0.1-rc.31",
    "hono": "^4.13.7"
  },
  "peerDependenciesMeta": {
    "@fastify/websocket": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    },
    "crossws": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/proxy-addr": "^5.1.0",
    "@types/ws": "^8.5.12",
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.0",
    "@hono/node-server": "^2.1.1",
    "@livething/client": "workspace:*",
    "@livething/server": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "crossws": "^0.4.12",
    "crossws-v1": "npm:crossws@0.3.5",
    "fastify": "^5.12.3",
    "h3": "^2.0.1-rc.31",
    "h3-v1": "npm:h3@1.15.11",
    "hono": "^4.13.7",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "vite": "8.0.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
