{
  "name": "@livething/plugin-collaboration",
  "version": "1.0.0-beta.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "fast-diff": "^1.3.0"
  },
  "peerDependencies": {
    "@livething/core": "^1.0.0-beta.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@livething/core": "workspace:*",
    "arktype": "^2.2.10",
    "valibot": "^1.5.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  }
}
