{
  "name": "@livething/website",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "dev:prepare": "nuxt prepare",
    "build": "nuxt build",
    "generate": "NODE_OPTIONS=--max-old-space-size=6144 NITRO_PRESET=static nuxt generate",
    "audit:docs": "node ./scripts/run-lighthouse.mjs",
    "preview": "pnpm run generate && wrangler dev",
    "deploy": "pnpm run generate && wrangler deploy",
    "deploy:preview": "pnpm run generate && wrangler versions upload",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf .nuxt .data .output node_modules .wrangler .lighthouseci .lighthouse-results"
  },
  "dependencies": {
    "@nuxt/content": "^3.14.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/ui": "^4.7.1",
    "@pierre/diffs": "^1.2.12",
    "@resvg/resvg-js": "^2.6.2",
    "@vueuse/core": "14.3.0",
    "better-sqlite3": "^12.9.0",
    "docus": "^5.10.1",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.4",
    "nuxt-studio": "^1.6.1",
    "satori": "^0.19.3",
    "shaders": "^2.5.109"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify-json/vscode-icons": "^1.2.59",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}
