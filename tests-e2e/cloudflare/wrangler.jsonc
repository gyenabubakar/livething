{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wskit-e2e",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_SERVER",
        "class_name": "ReplayServer",
      },
      {
        "name": "REPLAY_CUSTOM_SERVER",
        "class_name": "ReplayCustomServer",
      },
      {
        "name": "MODULES_SERVER",
        "class_name": "ModulesServer",
      },
      {
        "name": "REPLAY_SNAPSHOT_SERVER",
        "class_name": "ReplaySnapshotServer",
      },
      {
        "name": "HTTP_REJECT_SERVER",
        "class_name": "RejectHttpServer",
      },
      {
        "name": "ACK_SERVER",
        "class_name": "AckServer",
      },
      {
        "name": "BINARY_SERVER",
        "class_name": "BinaryServer",
      },
      { "name": "INCOMING_SERVER", "class_name": "IncomingServer" },
      { "name": "REQUEST_SERVER", "class_name": "RequestServer" },
      { "name": "STREAM_BASIC_SERVER", "class_name": "StreamBasicServer" },
      { "name": "STREAM_NUDGES_SERVER", "class_name": "StreamNudgesServer" },
      { "name": "STREAM_BROADCAST_SERVER", "class_name": "StreamBroadcastServer" },
      { "name": "CHANNEL_STATIC_SERVER", "class_name": "ChannelStaticServer" },
      { "name": "CHANNEL_DYNAMIC_SERVER", "class_name": "ChannelDynamicServer" },
      { "name": "CHANNEL_SCOPE_ISOLATION_SERVER", "class_name": "ChannelScopeIsolationServer" },
      { "name": "CHANNEL_KEY_COLLISION_SERVER", "class_name": "ChannelKeyCollisionServer" },
      { "name": "ERROR_HOOK_ISOLATION_SERVER", "class_name": "ErrorHookIsolationServer" },
      { "name": "LIFECYCLE_HOOKS_SERVER", "class_name": "LifecycleHooksServer" },
      { "name": "NAMESPACE_SERVER", "class_name": "NamespaceServer" },
      { "name": "INTERCEPT_SERVER", "class_name": "InterceptServer" },
      { "name": "SEQUENCE_SERVER", "class_name": "SequenceServer" },
      { "name": "DEDUP_SERVER", "class_name": "DedupServer" },
      { "name": "HIBERNATION_SERVER", "class_name": "HibernationServer" },
      { "name": "SCHEDULED_SERVER", "class_name": "ScheduledServer" },
      { "name": "ERRORS_FACTORY_SERVER", "class_name": "ErrorsFactoryServer" },
      { "name": "ERRORS_CONTROL_FLOW_SERVER", "class_name": "ErrorsControlFlowServer" },
      { "name": "CTX_SEND_SERVER", "class_name": "CtxSendServer" },
      { "name": "CTX_CHANNELS_SERVER", "class_name": "CtxChannelsServer" },
      { "name": "CTX_SQL_SERVER", "class_name": "CtxSqlServer" },
      { "name": "CTX_KV_SERVER", "class_name": "CtxKvServer" },
      { "name": "CTX_TAGS_SERVER", "class_name": "CtxTagsServer" },
      { "name": "CTX_QUALITY_SERVER", "class_name": "CtxQualityServer" },
      { "name": "CTX_META_SERVER", "class_name": "CtxMetaServer" },
      { "name": "HEARTBEAT_SERVER", "class_name": "HeartbeatServer" },
      { "name": "PROTOCOL_PINGS_SERVER", "class_name": "ProtocolPingsServer" },
      { "name": "FULL_IMPORT_SERVER", "class_name": "FullImportServer" },
      { "name": "MULTIFILE_SERVER", "class_name": "MultifileServer" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebSocketServer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ReplayServer", "ModulesServer"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ReplayCustomServer"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ReplaySnapshotServer"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["RejectHttpServer"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["AckServer", "BinaryServer"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "IncomingServer",
        "RequestServer",
        "StreamBasicServer",
        "StreamNudgesServer",
        "StreamBroadcastServer",
        "ChannelStaticServer",
        "ChannelDynamicServer",
        "LifecycleHooksServer",
        "NamespaceServer",
        "InterceptServer",
        "SequenceServer",
        "DedupServer",
        "HibernationServer",
        "ScheduledServer",
        "ErrorsFactoryServer",
        "ErrorsControlFlowServer",
        "CtxSendServer",
        "CtxChannelsServer",
        "CtxSqlServer",
        "CtxKvServer",
        "CtxTagsServer",
        "CtxQualityServer",
        "CtxMetaServer",
      ],
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["HeartbeatServer", "ProtocolPingsServer"],
    },
    {
      "tag": "v9",
      "deleted_classes": ["WebSocketServer"],
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["FullImportServer", "MultifileServer"],
    },
    {
      "tag": "v11",
      "new_sqlite_classes": ["ChannelScopeIsolationServer"],
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["ChannelKeyCollisionServer"],
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["ErrorHookIsolationServer"],
    },
  ],
}
