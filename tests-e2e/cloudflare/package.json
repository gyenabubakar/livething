{
  "name": "@wskit/tests-e2e-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean:test-state": "rm -rf .wrangler/state-* .wrangler/tmp test-results",
    "dev": "pnpm run dev:ui",
    "dev:ui": "vite dev --host 127.0.0.1 --port 4173",
    "dev:worker": "pnpm run clean:test-state && wrangler dev --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state-8787",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run clean:test-state && playwright test",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf node_modules dist .svelte-kit build"
  },
  "dependencies": {
    "@wskit/core": "workspace:*",
    "@wskit/server": "workspace:*",
    "@wskit/server-cloudflare": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.14.0"
  }
}
