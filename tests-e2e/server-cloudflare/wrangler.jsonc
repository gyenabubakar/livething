{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wskit-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "REPLAY_SERVER", "class_name": "ReplayServer" },
      { "name": "REPLAY_CUSTOM_SERVER", "class_name": "ReplayCustomServer" },
      { "name": "PLUGINS_SERVER", "class_name": "PluginsServer" },
      { "name": "REPLAY_SNAPSHOT_SERVER", "class_name": "ReplaySnapshotServer" },
      { "name": "HTTP_REJECT_SERVER", "class_name": "RejectHttpServer" },
      { "name": "ACK_SERVER", "class_name": "AckServer" },
      { "name": "INCOMING_SERVER", "class_name": "IncomingServer" },
      { "name": "REQUEST_SERVER", "class_name": "RequestServer" },
      { "name": "STREAM_BASIC_SERVER", "class_name": "StreamBasicServer" },
      { "name": "STREAM_NUDGES_SERVER", "class_name": "StreamNudgesServer" },
      { "name": "STREAM_BROADCAST_SERVER", "class_name": "StreamBroadcastServer" },
      { "name": "CHANNEL_STATIC_SERVER", "class_name": "ChannelStaticServer" },
      { "name": "CHANNEL_DYNAMIC_SERVER", "class_name": "ChannelDynamicServer" },
      { "name": "PERSISTENCE_SERVER", "class_name": "PersistenceServer" },
      { "name": "TYPED_TAGS_SERVER", "class_name": "TypedTagsServer" },
      { "name": "CHANNEL_SCOPE_ISOLATION_SERVER", "class_name": "ChannelScopeIsolationServer" },
      { "name": "CHANNEL_KEY_COLLISION_SERVER", "class_name": "ChannelKeyCollisionServer" },
      { "name": "ERROR_HOOK_ISOLATION_SERVER", "class_name": "ErrorHookIsolationServer" },
      { "name": "REPLAY_MEMBERSHIP_GATE_SERVER", "class_name": "ReplayMembershipGateServer" },
      { "name": "REPLAY_CUSTOM_CASCADE_SERVER", "class_name": "ReplayCustomCascadeServer" },
      {
        "name": "STATIC_VS_FAMILY_ISOLATION_SERVER",
        "class_name": "StaticVsFamilyIsolationServer",
      },
      {
        "name": "REPLAY_FAMILY_KEY_EQUALS_NAME_SERVER",
        "class_name": "ReplayFamilyKeyEqualsNameServer",
      },
      { "name": "LIFECYCLE_HOOKS_SERVER", "class_name": "LifecycleHooksServer" },
      { "name": "INTERCEPT_SERVER", "class_name": "InterceptServer" },
      { "name": "SEQUENCE_SERVER", "class_name": "SequenceServer" },
      { "name": "DEDUP_SERVER", "class_name": "DedupServer" },
      { "name": "HIBERNATION_SERVER", "class_name": "HibernationServer" },
      { "name": "SCHEDULED_SERVER", "class_name": "ScheduledServer" },
      { "name": "ERRORS_FACTORY_SERVER", "class_name": "ErrorsFactoryServer" },
      { "name": "ERRORS_CONTROL_FLOW_SERVER", "class_name": "ErrorsControlFlowServer" },
      { "name": "CTX_SEND_SERVER", "class_name": "CtxSendServer" },
      { "name": "CTX_CHANNELS_SERVER", "class_name": "CtxChannelsServer" },
      { "name": "CTX_SQL_SERVER", "class_name": "CtxSqlServer" },
      { "name": "CTX_KV_SERVER", "class_name": "CtxKvServer" },
      { "name": "CTX_TAGS_SERVER", "class_name": "CtxTagsServer" },
      { "name": "CTX_QUALITY_SERVER", "class_name": "CtxQualityServer" },
      { "name": "CTX_META_SERVER", "class_name": "CtxMetaServer" },
      { "name": "KEEPALIVE_SERVER", "class_name": "KeepaliveServer" },
      { "name": "PROTOCOL_PINGS_SERVER", "class_name": "ProtocolPingsServer" },
      { "name": "MULTIFILE_SERVER", "class_name": "MultifileServer" },
      { "name": "RATE_LIMIT_SERVER", "class_name": "RateLimitServer" },
      { "name": "STREAM_DURABLE_SERVER", "class_name": "StreamDurableServer" },
      { "name": "STREAM_DURABLE_SCOPED_SERVER", "class_name": "StreamDurableScopedServer" },
      {
        "name": "STREAM_DURABLE_BROADCAST_SERVER",
        "class_name": "StreamDurableBroadcastServer",
      },
      { "name": "GROUP_FULL_SURFACE_SERVER", "class_name": "GroupFullSurfaceServer" },
      { "name": "CHANNEL_CHECK_COMMIT_SERVER", "class_name": "ChannelCheckCommitServer" },
      { "name": "CTX_LOCALS_SERVER", "class_name": "CtxLocalsServer" },
      { "name": "MULTI_STATE_SERVER", "class_name": "MultiStateServer" },
      { "name": "DURABLE_CONFIG_SERVER", "class_name": "DurableConfigServer" },
    ],
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReplayServer",
        "ReplayCustomServer",
        "ReplaySnapshotServer",
        "PluginsServer",
        "RejectHttpServer",
        "AckServer",
        "IncomingServer",
        "RequestServer",
        "StreamBasicServer",
        "StreamNudgesServer",
        "StreamBroadcastServer",
        "ChannelStaticServer",
        "ChannelDynamicServer",
        "ChannelScopeIsolationServer",
        "ChannelKeyCollisionServer",
        "ErrorHookIsolationServer",
        "ReplayMembershipGateServer",
        "ReplayCustomCascadeServer",
        "StaticVsFamilyIsolationServer",
        "ReplayFamilyKeyEqualsNameServer",
        "LifecycleHooksServer",
        "NamespaceServer",
        "InterceptServer",
        "SequenceServer",
        "DedupServer",
        "HibernationServer",
        "ScheduledServer",
        "ErrorsFactoryServer",
        "ErrorsControlFlowServer",
        "CtxSendServer",
        "CtxChannelsServer",
        "CtxSqlServer",
        "CtxKvServer",
        "CtxTagsServer",
        "CtxQualityServer",
        "CtxMetaServer",
        "KeepaliveServer",
        "ProtocolPingsServer",
        "MultifileServer",
        "PersistenceServer",
        "TypedTagsServer",
        "RateLimitServer",
        "StreamDurableServer",
        "StreamDurableScopedServer",
        "StreamDurableBroadcastServer",
        "GroupFullSurfaceServer",
        "BenchServer",
        "ChannelCheckCommitServer",
        "CtxLocalsServer",
      ],
    },
    {
      "tag": "v2",
      "deleted_classes": ["BenchServer"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MultiStateServer", "DurableConfigServer"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["NamespaceServer"],
    },
  ],
}
