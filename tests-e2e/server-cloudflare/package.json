{
  "name": "@wskit/tests-e2e-server-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean:test-state": "rm -rf .wrangler/state .wrangler/state-* .wrangler/tmp",
    "dev:worker": "pnpm run clean:test-state && wrangler dev --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state-8787",
    "test:e2e": "WSKIT_E2E_SERVER_COMMAND='pnpm run dev:worker' WSKIT_E2E_SERVER_CWD=\"$PWD\" pnpm --filter @wskit/tests-e2e-client-raw exec playwright test",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "clean": "rm -rf node_modules .wrangler"
  },
  "dependencies": {
    "@wskit/core": "workspace:*",
    "@wskit/server": "workspace:*",
    "@wskit/server-cloudflare": "workspace:*",
    "@wskit/tests-e2e-handlers": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "wrangler": "^4.14.0"
  }
}
