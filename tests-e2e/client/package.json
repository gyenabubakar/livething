{
  "name": "@livething/tests-e2e-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:ws": "node tests/puppet/ws-server.mjs",
    "build:client": "[ -n \"$LIVETHING_E2E_PREBUILT\" ] || pnpm --filter @livething/client --filter @livething/plugin-collaboration run build",
    "test:e2e": "pnpm run build:client && playwright test",
    "test:e2e:cloudflare": "pnpm run build:client && LIVETHING_E2E_NO_STREAM_ABORT=1 LIVETHING_E2E_SERVER_COMMAND='pnpm --filter @livething/tests-e2e-server-cloudflare run dev:worker' LIVETHING_E2E_SERVER_PORT=${LIVETHING_E2E_SERVER_PORT:-8787} playwright test",
    "test:e2e:node:http": "pnpm run build:client && LIVETHING_E2E_SERVER_COMMAND='pnpm --filter @livething/tests-e2e-server-node run dev:node-http' LIVETHING_E2E_SERVER_PORT=${LIVETHING_E2E_SERVER_PORT:-8787} playwright test",
    "test:e2e:node": "pnpm run test:e2e:node:http",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules test-results playwright-report"
  },
  "dependencies": {
    "@livething/client": "workspace:*",
    "@livething/core": "workspace:*",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@livething/plugin-collaboration": "workspace:*",
    "@blocknote/core": "0.57.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-collaboration": "3.34.0",
    "@tiptap/extension-collaboration-caret": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/y-tiptap": "^3.0.5",
    "monaco-editor": "0.54.0",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "1.42.9",
    "quill": "^2.0.3",
    "quill-cursors": "^4.3.0",
    "y-codemirror.next": "^0.3.6",
    "y-monaco": "^0.1.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-quill": "^1.0.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/ws": "^8.5.12",
    "@livething/tests-e2e-handlers": "workspace:*",
    "@livething/tests-e2e-server-cloudflare": "workspace:*",
    "@livething/tests-e2e-server-node": "workspace:*",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "ws": "^8.18.0"
  }
}
